# Copy to .env when you run the API outside the Codespace (the Codespace
# and CI set these for you). .env is git-ignored. Variables that are
# already set in the environment win over .env.

# database used by npm start, npm run migrate and npm run db:seed
DATABASE_URL=postgres://cars:cars@localhost:5432/cars
# database used by npm test; its cars table is emptied before each test
TEST_DATABASE_URL=postgres://cars:cars@localhost:5432/cars_test

# where npm start listens (defaults: 127.0.0.1 and 3000)
HOST=127.0.0.1
PORT=3000
