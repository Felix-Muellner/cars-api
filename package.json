{
  "name": "cars",
  "version": "2.0.0",
  "description": "A lightweight RESTful API for managing car inventory data, built with Node.js and Express.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "lint": "eslint .",
    "lint:api": "node scripts/build-openapi.js && redocly lint openapi.json",
    "check": "npm run lint && npm run lint:api && npm test",
    "check:migrations": "node scripts/check-migrations.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felix-Muellner/cars-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "bugs": {
    "url": "https://github.com/Felix-Muellner/cars-api/issues"
  },
  "homepage": "https://github.com/Felix-Muellner/cars-api#readme",
  "dependencies": {
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.76.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
